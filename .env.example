# NK APP Configuration
# =====================
# GEMINI_API_KEY: Required for Gemini AI API calls on the secure backend.
# In AI Studio, configure this via the Secrets panel.
# Never hardcode production keys in the APK or public repositories.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# GEMINI_MODEL: Supported Gemini model eligible for the API free tier.
# Supported free tier models: gemini-3.5-flash-lite, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite

# BACKEND_URL: Base URL of the secure Gemini proxy backend.
# Default for local Android emulator: http://10.0.2.2:3000
# For physical devices or cloud: https://your-backend-host.com
BACKEND_URL=http://10.0.2.2:3000

# Server port (when running backend server)
PORT=3000

